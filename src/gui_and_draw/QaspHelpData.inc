static const QaspHelp::ParmHelp g_ParmHelp[] =
{
    { "Rotor", "RotorThrust", "", "Thrust", "Thrust is the pushing or pulling force a propeller or rotor produces.", "In straight, level flight, forward thrust greater than drag (air resistance) lets the aircraft speed up. Extra thrust can also help it climb.", "If thrust is 1,200 N and drag is 1,000 N, the forward force left over is 200 N.", "Force units consistent with the solver inputs: N in SI or lbf with slug-ft-s inputs." },
    { "Rotor", "RotorPower", "", "Power", "Power is how quickly the engine or motor supplies energy to turn the propeller.", "More available power can support more thrust, but the propeller and flight speed determine how much. Power is not the same as thrust.", "In consistent SI inputs, 20,000 means 20,000 watts, not 20 kilowatts.", "W with kg-m-s inputs; ft-lbf/s with slug-ft-s inputs, not horsepower." },
    { "Rotor", "RotorTorque", "", "Torque", "Torque is the twisting force the motor applies to the propeller shaft.", "The motor and shaft must withstand it. Torque multiplied by turning speed gives shaft power.", "A longer spanner turns a stiff nut more easily: it gives more torque.", "N-m with SI inputs; ft-lbf with slug-ft-s inputs." },
    { "Rotor", "RotorRPM", "", "Propeller speed", "RPM is how many full turns the propeller makes in one minute.", "Changing RPM changes blade airflow, thrust, power demand and noise. Faster is not automatically more efficient.", "2,400 RPM means 40 complete turns every second.", "Revolutions per minute." },
    { "Rotor", "RotorDiameter", "", "Rotor diameter", "The diameter is the distance across the full circle swept by the blade tips.", "A larger disk can move more air, but needs ground clearance and a suitable motor and blade design.", "A 2 m diameter gives a 1 m distance from the centre to a blade tip.", "Your model length units; use one consistent unit system." },
    { "Rotor", "RotorHubDiameter", "", "Hub diameter", "The hub is the centre of the rotor disk where the blade roots attach.", "This setting describes the central region rather than the blade-tip size. An oversized hub leaves less working disk area.", "Do not enter the full propeller diameter in the hub box.", "Your model length units; use one consistent unit system." },
    { "Rotor", "AutoHubDiaFlag", "", "Automatic hub size", "This takes the hub diameter from the propeller shape instead of a manually entered value.", "It keeps the rotor disk setup linked to the propeller geometry.", "Use Auto after changing the blade-root shape so you do not keep an old hub size.", "" },
    { "Rotor", "RotorCT", "", "Thrust coefficient", "C_T describes thrust relative to air density, turning speed and propeller diameter.", "At the same density, RPM and diameter, a larger C_T means more thrust. It is not thrust in newtons.", "Use coefficients measured or predicted for your propeller and operating condition.", "Ratio; no units." },
    { "Rotor", "RotorCP", "", "Power coefficient", "C_P describes shaft power relative to air density, turning speed and propeller diameter.", "At the same density, RPM and diameter, a larger C_P means the propeller needs more shaft power.", "Do not enter engine horsepower in a C_P box.", "Ratio; no units." },
    { "Rotor", "RotorCQ", "", "Torque coefficient", "C_Q describes shaft torque relative to density, turning speed and propeller diameter.", "It helps relate propeller loading to the torque required from the motor.", "Compare C_Q values only when the same coefficient convention is used.", "Ratio; no units." },
    { "Rotor", "RotorJ", "", "Advance ratio", "Advance ratio compares forward airspeed with how fast the propeller turns and how large it is.", "It identifies the operating point on a propeller performance chart.", "At zero forward speed J is zero, even when the propeller is turning.", "Ratio; no units." },
    { "Rotor", "RotorEta", "", "Propeller efficiency", "Efficiency is useful forward thrust power divided by the shaft power supplied.", "A more efficient propeller wastes less of the supplied power at that flight condition.", "0.80 means 80 percent in forward flight. This efficiency measure is not useful for static thrust.", "Ratio; no units." },
    { "WingGeom", "TotalSpan", "", "Whole-wing span", "Span measures how far the wing extends from root to tip, including its mirrored side when symmetry is on.", "At the same lift and speed, a greater span generally reduces the drag caused by producing lift, but adds structural demands.", "With a single mirrored section, 5 units on each side gives 10 units total.", "Your model length units; use one consistent unit system." },
    { "WingGeom", "TotalProjectedSpan", "", "Projected wing span", "This is the wing width measured in a top view, ignoring its upward or downward tilt.", "An angled wing has less top-view width than the same wing laid flat.", "Use this to compare the top-view sizes of a flat wing and a wing with dihedral.", "Your model length units; use one consistent unit system." },
    { "WingGeom", "TotalArea", "", "Whole-wing area", "Wing area measures the size of the wing using its front-to-back chords and section widths. It includes the mirrored side when symmetry is on.", "For the same weight and maximum lift coefficient, more area lowers the estimated stall speed. Weight and drag may also change.", "A simple rectangular wing 10 m wide and 1.5 m deep has 15 square metres of area.", "Your model length units squared." },
    { "WingGeom", "TotalChord", "", "Average wing chord", "Chord is the front-to-back length of a wing. This value averages the section average chords.", "A greater chord at the same span increases wing area. On a multi-section wing, this simple average is not necessarily area divided by span.", "A rectangular wing with 1.5 m chords has a 1.5 m average chord.", "Your model length units; use one consistent unit system." },
    { "WingGeom", "TotalAR", "", "Whole-wing aspect ratio", "Aspect ratio describes how long and narrow the wing is: span squared divided by area.", "Higher aspect ratio generally reduces lift-related drag, but does not guarantee lower total drag or a lighter wing.", "A 10 m span and 20 square metres of area give an aspect ratio of 5.", "Ratio; no units." },
    { "WingGeom", "MAC", "", "Mean aerodynamic chord", "MAC is a representative wing chord used to describe aerodynamic balance and pitching moments.", "It provides a useful length for comparing centre-of-gravity positions, especially on tapered wings.", "A CG shift of 0.1 m is 10 percent of MAC when MAC is 1 m.", "Your model length units; use one consistent unit system." },
    { "WingGeom", "CurvedArea", "", "Area with curved edges", "This measures wing area while accounting for curved leading and trailing edges.", "It can differ from the straight-edged section planform area and change the chosen reference area for analysis.", "A curved wingtip can change this area without changing the section corner points.", "Your model length units squared." },
    { "WingGeom", "RelativeDihedralFlag", "", "Relative dihedral", "Choose whether section dihedral is measured from the previous section or from the common reference plane.", "This changes how section angles combine along a multi-section wing.", "Check the complete wing after changing the mode; the same entered number can describe a different final angle.", "" },
    { "WingGeom", "RelativeTwistFlag", "", "Relative twist", "Choose whether section twist is added to the previous section or measured from the common reference orientation.", "This changes how section angles combine along a multi-section wing.", "Check the complete wing after changing the mode; the same entered number can describe a different final angle.", "" },
    { "WingGeom", "CorrectAirfoilthicknessFlag", "", "Airfoil thickness correction", "This adjusts airfoil thickness when sections are rotated to match dihedral.", "It keeps the intended section thickness under that rotation. Near a 90-degree dihedral break the correction can become very large.", "Make a vertical fin by rotating the whole wing on XForm, not by forcing a section to 90-degree dihedral.", "" },
    { "XSec", "Span", "", "Section span", "The width of this one wing section, from its inner edge to its outer edge.", "Increasing it extends this section; the wing totals also depend on the other sections and symmetry.", "On a mirrored, single-section wing, a section span of 5 gives a total span of 10.", "Your model length units; use one consistent unit system." },
    { "XSec", "ProjectedSpan", "", "Projected section span", "This section's width as measured from directly above.", "Tilting the section upward reduces its top-view width.", "Compare it with section span after adding dihedral.", "Your model length units; use one consistent unit system." },
    { "XSec", "Area", "", "Section wing area", "The size of this section's flat wing outline, not the whole mirrored wing.", "More section area can reduce wing loading, but mass and aerodynamic behaviour still need analysis.", "For a rectangular section, area equals section span times chord.", "Your model length units squared." },
    { "XSec", "Aspect", "", "Section aspect ratio", "The section span squared divided by its planform area.", "This sets the section's long-and-narrow shape; it is not necessarily the whole-wing aspect ratio.", "A section 5 m wide and 1 m deep has aspect ratio 5.", "Ratio; no units." },
    { "XSec", "Root_Chord", "", "Section root chord", "The front-to-back wing length at this section's inner end.", "Changing it changes area and taper and can affect adjacent sections.", "The first section's root chord is normally the chord nearest the fuselage.", "Your model length units; use one consistent unit system." },
    { "XSec", "Tip_Chord", "", "Section tip chord", "The front-to-back wing length at this section's outer end.", "Reducing it makes this section more tapered; stall behaviour also depends on the airfoil and twist.", "A 1 m tip chord with a 2 m root chord gives a taper ratio of 0.5.", "Your model length units; use one consistent unit system." },
    { "XSec", "Avg_Chord", "", "Section average chord", "The average front-to-back length of this wing section.", "For a straight-edged section, it is the average of the root and tip chords.", "A 2 m root chord and 1 m tip chord average to 1.5 m.", "Your model length units; use one consistent unit system." },
    { "XSec", "Taper", "", "Taper ratio", "Tip chord divided by root chord: how much the wing narrows toward this section's outer end.", "Lower values make a more pointed section; they do not automatically give safer stalling or better performance.", "1 means equal chords; 0.5 means the tip is half as deep as the root.", "Ratio; no units." },
    { "XSec", "Sweep", "", "Wing sweep", "The backward or forward angle of this section at the selected chord location.", "Sweep changes where area lies along the aircraft and can help at high speed, but has low-speed trade-offs.", "0 degrees is unswept at the selected measurement line.", "Degrees." },
    { "XSec", "Sec_Sweep", "", "Secondary sweep", "The sweep measured at a second front-to-back position on the chord.", "It helps define the same section geometry using another measurement line.", "Leading-edge sweep and trailing-edge sweep can differ on a tapered wing.", "Degrees." },
