    { "XSec", "Sec_Sweep_Location", "", "Secondary sweep line", "Where along the chord the secondary sweep angle is measured.", "It must describe a different chordwise line from the main sweep location.", "Use 1 for trailing-edge sweep if the main location is 0.", "Ratio; no units." },
    { "XSec", "Dihedral", "", "Dihedral", "The upward or downward tilt of a wing section as seen from the front.", "It affects how the aircraft responds to sideways airflow. Positive dihedral often helps roll stability, but does not guarantee self-levelling.", "A shallow V shape seen head-on has positive dihedral.", "Degrees." },
    { "XSec", "Twist", "", "Wing twist", "The rotation applied to the airfoil at this section station.", "It changes local angle of attack. A lower tip angle can help the root stall first, depending on the complete wing.", "A tip set 2 degrees lower than the root is called 2 degrees of washout.", "Degrees." },
