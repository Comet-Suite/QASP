    { "VSPAERO", "MachEnd", "", "Mach number - end", "Airspeed divided by the local speed of sound. Last value in the analysis range.", "It describes how compressibility affects airflow; the same Mach need not mean the same speed at every temperature.", "Mach 0.2 means one fifth of the local speed of sound.", "Ratio; no units." },
    { "VSPAERO", "MachNpts", "", "Mach number - number of cases", "How many evenly spaced values of mach number the solver will analyse, including the ends.", "More values give a finer set of cases and take longer; they do not change the aircraft geometry.", "For one operating point, use 1. With 3 points, 0 to 10 becomes 0, 5 and 10.", "Count." },
    { "VSPAERO", "ReCref", "", "Reynolds number - start", "A number comparing air motion with viscosity, using the reference chord as the length. First value in the analysis range.", "It affects skin friction and airfoil behaviour. Very small aircraft can behave differently from scaled-up ones.", "A small model and a full-size aircraft at the same speed need not have the same Reynolds number.", "Ratio; no units." },
    { "VSPAERO", "ReCrefEnd", "", "Reynolds number - end", "A number comparing air motion with viscosity, using the reference chord as the length. Last value in the analysis range.", "It affects skin friction and airfoil behaviour. Very small aircraft can behave differently from scaled-up ones.", "A small model and a full-size aircraft at the same speed need not have the same Reynolds number.", "Ratio; no units." },
    { "VSPAERO", "ReCrefNpts", "", "Reynolds number - number of cases", "How many evenly spaced values of reynolds number the solver will analyse, including the ends.", "More values give a finer set of cases and take longer; they do not change the aircraft geometry.", "For one operating point, use 1. With 3 points, 0 to 10 becomes 0, 5 and 10.", "Count." },
    { "VSPAERO", "Sref", "", "Reference wing area", "The area used to turn lift and drag forces into comparison numbers called coefficients.", "Changing this reference rescales the coefficients; it does not add physical wing area.", "Use the same reference area when comparing two sets of CL and CD results.", "Your model length units squared." },
    { "VSPAERO", "Vinf", "", "Airspeed", "The speed of the undisturbed air relative to the aircraft.", "Airspeed changes aerodynamic forces and propeller operating conditions. It is not the aircraft's speed over the ground.", "A headwind can make airspeed different from ground speed.", "Length per second, consistent with the solver density and geometry inputs." },
    { "ParasiteDrag", "Sref", "", "Reference wing area", "The area used to turn lift and drag forces into comparison numbers called coefficients.", "Changing this reference rescales the coefficients; it does not add physical wing area.", "Use the same reference area when comparing two sets of CL and CD results.", "Your model length units squared." },
    { "ParasiteDrag", "Vinf", "", "Airspeed", "The speed of the undisturbed air relative to the aircraft.", "Airspeed changes aerodynamic forces and propeller operating conditions. It is not the aircraft's speed over the ground.", "A headwind can make airspeed different from ground speed.", "Use the displayed speed unit." },
    { "VSPAERO", "bref", "", "Reference span", "The span used to scale rolling and yawing moment coefficients.", "This is an analysis reference length, not a command to resize the aircraft.", "Keep reference lengths unchanged when comparing coefficients between runs.", "Your model length units; use one consistent unit system." },
    { "VSPAERO", "cref", "", "Reference chord", "The chord used to scale pitching moment coefficients.", "This is an analysis reference length, not a command to resize the aircraft.", "Keep reference lengths unchanged when comparing coefficients between runs.", "Your model length units; use one consistent unit system." },
    { "VSPAERO", "Rho", "", "Air density", "How much air mass occupies a unit of volume at the flight condition.", "At the same true airspeed, thinner air gives smaller aerodynamic forces for unchanged coefficients. It also changes propeller loading.", "Air is usually thinner at high altitude. This is not the density of the wing material.", "Mass per length cubed, consistent with geometry and speed: kg/m^3 in SI or slug/ft^3 in slug-ft-s inputs." },
    { "VSPAERO", "NCPU", "", "Solver processors", "How many processor workers the aerodynamic solver may use.", "More workers can reduce calculation time on a suitable computer; they do not make the physics more accurate.", "Leave processing capacity for other programs if your PC becomes unresponsive.", "Count." },
    { "VSPAERO", "WakeNumIter", "", "Wake iterations", "How many repeated updates are allowed for the airflow trailing behind the aircraft.", "Enough updates help the result settle. Too few can leave an unconverged answer.", "Compare force histories instead of trusting a result only because the solver finished.", "Count." },
    { "VSPAERO", "RootWakeNodes", "", "Wake nodes", "The number of divisions used to describe the trailing airflow.", "More divisions resolve more wake detail but increase computation.", "Check that adding detail no longer changes the result significantly.", "Count." },
    { "VSPAERO", "CLMax2D", "", "Airfoil maximum lift coefficient", "The assumed maximum section lift coefficient used by the selected stall model.", "It limits the modelled section lift when that model is enabled. It is not automatically the complete wing CLmax.", "Use appropriate airfoil data rather than increasing the number until a design appears to fly.", "Ratio; no units." },
    { "VSPAERO", "StallModel", "", "Stall model", "Choose whether to apply the available approximate stall treatment.", "This changes the aerodynamic model; it does not make a high-angle result a validated stall prediction.", "A successful solver run is not proof that a real aircraft can fly safely at that angle.", "" },
    { "VSPAERO", "Symmetry", "", "Solver mirror symmetry", "Solve a symmetric case using the XZ centre plane.", "It can reduce work, but is only appropriate when the geometry and flight condition support that symmetry.", "A sideslip case or asymmetric aircraft may need a full-model analysis.", "" },
    { "VSPAERO", "Xcg", "", "X moment reference", "The X coordinate of the point about which aerodynamic moments are reported.", "Moving the reference point changes reported moments without changing the aircraft shape.", "Use the calculated CG when you want moments about the mass balance point.", "Your model length units; use one consistent unit system." },
    { "VSPAERO", "Ycg", "", "Y moment reference", "The Y coordinate of the point about which aerodynamic moments are reported.", "Moving the reference point changes reported moments without changing the aircraft shape.", "Use the calculated CG when you want moments about the mass balance point.", "Your model length units; use one consistent unit system." },
    { "VSPAERO", "Zcg", "", "Z moment reference", "The Z coordinate of the point about which aerodynamic moments are reported.", "Moving the reference point changes reported moments without changing the aircraft shape.", "Use the calculated CG when you want moments about the mass balance point.", "Your model length units; use one consistent unit system." },
    { "ParasiteDrag", "Density", "", "Air density", "How much air mass occupies a unit of volume at the selected flight condition.", "It affects aerodynamic forces and Reynolds number, not the mass of the aircraft structure.", "At the same true airspeed, high-altitude air usually produces less lift for the same wing angle.", "Use the displayed density unit." },
    { "ParasiteDrag", "Alt", "", "Flight altitude", "Height above sea level used to calculate the atmosphere for this drag estimate.", "It changes air density, temperature and viscosity. It is not a calculated maximum flight altitude.", "Entering 3,000 m asks for drag at that altitude; it does not prove the aircraft can reach it.", "Use the displayed altitude unit." },
    { "ParasiteDrag", "Mach", "", "Mach number", "Airspeed divided by the local speed of sound.", "It affects compressibility corrections in the drag estimate.", "Mach 0.2 is one fifth of the local speed of sound.", "Ratio; no units." },
    { "ParasiteDrag", "Temp", "", "Air temperature", "The temperature of the surrounding air at the flight condition.", "It affects density, viscosity and the local speed of sound.", "A hot day changes performance even at the same airport elevation.", "Use the displayed temperature unit." },
    { "ParasiteDrag", "DeltaTemp", "", "Temperature offset", "How much warmer or colder the air is than the standard atmosphere at this altitude.", "It changes the atmosphere estimate without changing altitude.", "An offset of +10 means ten degrees warmer than standard.", "Use the displayed temperature-difference unit." },
    { "ParasiteDrag", "Pres", "", "Air pressure", "The surrounding atmospheric pressure at the flight condition.", "Pressure together with temperature determines air density in the atmosphere model.", "Air pressure normally falls as you climb.", "Use the displayed pressure unit." },
    { "ParasiteDrag", "DynaVisc", "", "Air viscosity", "How strongly air resists being sheared, or sliding in layers.", "Viscosity helps determine skin friction and Reynolds number.", "It matters even though air seems much less sticky than oil.", "Use the displayed viscosity unit." },
    { "ParasiteDrag", "Re_L", "", "Reynolds number per unit length", "Reynolds number divided by the reference length.", "Multiplying it by a component length gives that component's Reynolds number, using consistent length units.", "Do not paste a full chord Reynolds number into a per-unit-length field.", "Inverse model-length units." },
    { "ParasiteDrag", "LengthUnit", "", "Geometry length units", "Tell the drag tool what one unit in your geometry represents.", "Using the wrong units changes physical size and Reynolds number. It does not automatically resize your saved geometry.", "If the model was drawn in metres, choose metres here.", "Unit selection." },
    { "ParasiteDrag", "VinfUnitType", "", "Airspeed units", "Choose how the entered airspeed is measured.", "A number in knots means a different speed from the same number in metres per second.", "Check the unit before copying a speed from a flight specification.", "Unit selection." },
    { "ParasiteDrag", "FreestreamType", "", "Atmosphere input method", "Choose which information defines the air, such as a standard atmosphere at an altitude.", "This controls which atmosphere fields are calculated and which you enter yourself.", "Use a standard-atmosphere mode when you know altitude rather than pressure and density.", "Mode." },
    { "ParasiteDrag", "ExcresVal", "", "Extra drag allowance", "An allowance for drag from details not represented by the smooth model.", "The selected allowance type determines whether the number means a percentage, drag count, or drag area.", "Protruding antennas and small gaps can create drag not captured by a simple fuselage.", "Depends on the selected allowance type." },
    { "ParasiteDragProps", "PercLam", "", "Laminar-flow percentage", "The estimated percentage of surface length with smooth, layered airflow before it becomes turbulent.", "More laminar flow generally lowers estimated skin-friction drag, but roughness and flight condition can prevent it.", "50 means 50 percent, not a fraction of 0.5.", "Percent." },
    { "ParasiteDragProps", "FFUser", "", "Shape drag factor", "A manual factor allowing for extra drag caused by component shape.", "A larger factor increases the empirical drag estimate; it does not change the physical shape.", "Use a defensible correlation rather than reducing the factor to improve a result.", "Ratio; no units." },
    { "ParasiteDragProps", "Roughness", "", "Surface roughness", "A measure of small bumps on the surface used by applicable drag correlations.", "A rough surface can alter transition and increase skin-friction drag.", "Rivet heads, dirt and poor finish can matter even on a smooth-looking CAD model.", "Check the selected drag correlation and its roughness units." },
